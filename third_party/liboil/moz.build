with Files("**"):
    BUG_COMPONENT = ("Core", "Graphics: ImageLib")

EXPORTS += [
    "oil_resample.h",
]

SOURCES += [
    "oil_resample.c",
]

# SSE2 path for x86/x64
if CONFIG["INTEL_ARCHITECTURE"]:
    SOURCES += ["oil_resample_sse2.c"]
    SOURCES["oil_resample_sse2.c"].flags += CONFIG["SSE2_FLAGS"]
    SOURCES += ["oil_resample_avx2.c"]
    SOURCES["oil_resample_avx2.c"].flags += ["-mavx2", "-mfma"]

# NEON path for aarch64
if CONFIG["TARGET_CPU"] == "aarch64":
    SOURCES += ["oil_resample_neon.c"]

FINAL_LIBRARY = "xul"

AllowCompilerWarnings()
